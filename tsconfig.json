// The root config only carries the shared options in tsconfig.base.json down to the packages.
// The `extends` + empty `files` pair is what keeps both TypeScript 6 (VS Code's bundled
// version) and TypeScript 7 (the workspace `tsc`) from reporting "no inputs were found" for
// a config that is never compiled on its own.
{
  "extends": "./tsconfig.base.json",
  "files": []
}
